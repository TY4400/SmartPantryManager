<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EEF5E8"
    android:padding="20dp">

    <!-- Top branding -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌿"
        android:textSize="38sp"
        android:gravity="center"
        android:layout_marginTop="35dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Smart Pantry Manager"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#294E25"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fresh ideas from what you already have"
        android:textSize="15sp"
        android:textColor="#6B725F"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <!-- Welcome card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFF8E7"
        android:elevation="5dp"
        android:padding="18dp"
        android:layout_marginBottom="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🥑  Welcome to your pantry"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#294E25"
            android:layout_marginBottom="7dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keep track of your ingredients and turn them into something delicious."
            android:textSize="14sp"
            android:textColor="#6B725F" />

    </LinearLayout>

    <!-- Dashboard Stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="18dp">

        <!-- Pantry Items Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginEnd="7dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌿"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/tvPantryCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#285A2A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pantry Items"
                android:textSize="13sp"
                android:textColor="#6B725F" />

        </LinearLayout>

        <!-- Ready to Cook Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginStart="7dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍲"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/tvReadyCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#285A2A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready to Cook"
                android:textSize="13sp"
                android:textColor="#6B725F" />

        </LinearLayout>

    </LinearLayout>

    <!-- Suggested Recipe Summary -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="14dp"
        android:background="#FFF7E6"
        android:padding="16dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🍽  WHAT CAN I MAKE?"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#285A2A"
            android:layout_marginBottom="7dp" />

        <TextView
            android:id="@+id/tvReadyMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checking your pantry for recipes..."
            android:textSize="13sp"
            android:textColor="#6B725F"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnViewSuggested"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="View Suggested Recipes  →"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:backgroundTint="#5B873E" />

    </LinearLayout>

    <!-- Push footer down -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌱  Plan • Cook • Waste Less"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#668A4C"
        android:gravity="center"
        android:layout_marginBottom="15dp" />

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <Button
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🏠&#10;Home"
            android:textSize="11sp"
            android:textColor="#285A2A"
            android:backgroundTint="#EEF6E8"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/navPantry"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🌿&#10;Pantry"
            android:textSize="11sp"
            android:textColor="#285A2A"
            android:backgroundTint="#FFFFFF"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/navRecipes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🍲&#10;Recipes"
            android:textSize="11sp"
            android:textColor="#285A2A"
            android:backgroundTint="#FFFFFF"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⚙&#10;Settings"
            android:textSize="11sp"
            android:textColor="#285A2A"
            android:backgroundTint="#FFFFFF"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>