<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="#FFFFFF">

    <!-- Ingredient icon -->
    <TextView
        android:id="@+id/tvItemIcon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:gravity="center"
        android:text="🥕"
        android:textSize="22sp"
        android:background="#EEF5E8" />

    <!-- Ingredient information -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/tvIngredientName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Carrots"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#294E25" />

        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vegetable"
            android:textSize="12sp"
            android:textColor="#8B6A4C"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Category indicator -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/tvCategoryIcon"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="🌿"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btnDeleteItem"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="×"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#8B5A2B"
            android:contentDescription="Delete ingredient" />

    </LinearLayout>
</LinearLayout>